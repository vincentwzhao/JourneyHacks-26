# Auth.js / NextAuth
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Enable the "Google Calendar API" on the same project, and add
# http://localhost:3000/api/auth/callback/google (and your deployed URL)
# as an authorized redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: enables AI-assisted urgent/important classification via Gemini.
# Without this, a rule-based heuristic is used instead.
GEMINI_API_KEY=
